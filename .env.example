# ─────────────────────────────────────────────────────────
# JNAB Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_SETTINGS_MODULE=jnab_backend.settings.prod

# Hosts (comma-separated)
ALLOWED_HOSTS=yourusername.pythonanywhere.com,api.yourdomain.com

# Frontend origin(s) for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# PythonAnywhere host (auto-added to ALLOWED_HOSTS)
PYTHONANYWHERE_HOST=yourusername.pythonanywhere.com

# Database (leave empty to use SQLite, or set a full PostgreSQL URL)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=JNAB <your@email.com>

# Redis cache (optional — leave empty to use local memory cache)
# REDIS_URL=redis://localhost:6379/0
